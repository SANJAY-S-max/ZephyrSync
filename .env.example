# ByteSync Environment Variables

# Database Setup (Neon PostgreSQL)
# You MUST provide this connection string to run the application
DATABASE_URL="postgres://user:password@endpoint.neon.tech/dbname"

# Server Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET="replace-this-with-a-very-long-random-string-in-production"

# Application Settings
STORAGE_DIR="./storage"
MAX_FILE_SIZE_MB=5120
CHUNK_SIZE_MB=8
UPLOAD_CONCURRENCY=4
ALLOWED_FILE_TYPES="pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png,gif,webp,mp3,wav,mp4,mkv,zip,rar,7z,csv,json,js,ts,html,css,java,py,exe,bin,iso,dmg,apk"

# Admin Setup (Applied on first startup if no admin exists)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="supersecretadminpassword"
